# Production only: the public URL of your deployed backend (no trailing slash).
# Local development does NOT need this - `npm run dev` proxies API calls to http://localhost:3002.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Local development only: where the Vite dev server forwards API calls (default http://localhost:3002)
# VITE_DEV_API_TARGET=http://localhost:3002
